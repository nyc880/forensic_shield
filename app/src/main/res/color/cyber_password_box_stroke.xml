<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: bright cyber green -->
    <item android:state_focused="true" android:color="#00FF66" />

    <!-- Pressed / hovered: medium cyber green -->
    <item android:state_pressed="true" android:color="#00D957" />
    <item android:state_hovered="true" android:color="#00D957" />

    <!-- Disabled: muted dark green -->
    <item android:state_enabled="false" android:color="#06351F" />

    <!-- Default: dark green border -->
    <item android:color="#0B5F35" />
</selector>
