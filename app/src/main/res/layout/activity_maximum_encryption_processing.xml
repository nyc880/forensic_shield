<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMaximumProcessing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingTop="36dp"
    android:paddingEnd="24dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:id="@+id/layoutMaximumEncrypting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressMaximumEncrypting"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/txtMaximumEncryptingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="encrypting... please wait"
            android:textColor="#00FF66"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMaximumEncryptingSubStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="building secure .enc.txt file"
            android:textColor="#0B8F4D"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
