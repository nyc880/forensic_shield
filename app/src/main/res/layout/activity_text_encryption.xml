<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071019"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <RadioGroup
            android:id="@+id/rg_encryption_tier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <RadioButton
                android:id="@+id/rb_medium_short"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium Short Encrypt"
                android:textColor="#FFFFFF"
                android:buttonTint="#C9A85F"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:checked="true"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rb_maximum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum Encrypt"
                android:textColor="#FFFFFF"
                android:buttonTint="#C9A85F"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </RadioGroup>

        <!-- Text Box Card containing EditText + Divider + 4 Buttons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#0A192F"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#C9A85F"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/main_text_box"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="Enter your text or encrypted text here..."
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#557799"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33C9A85F" />

                <!-- Bottom Toolbar inside Text Box Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_import"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#B45309"
                        app:cardCornerRadius="8dp"
                        app:strokeColor="#C9A85F"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📁"
                                android:textSize="12sp"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="IMPORT"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btn_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#37474F"
                        android:fontFamily="monospace"
                        android:text="CLEAR"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp" />

                    <Button
                        android:id="@+id/btn_paste"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#1E3A8A"
                        android:fontFamily="monospace"
                        android:text="PASTE"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp" />

                    <Button
                        android:id="@+id/btn_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#0F766E"
                        android:fontFamily="monospace"
                        android:text="COPY"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_share"
                android:layout_width="125dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1D4ED8"
                app:cardCornerRadius="10dp"
                app:strokeColor="#C9A85F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="SHARE"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_save"
                android:layout_width="135dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="10dp"
                app:strokeColor="#C9A85F"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:text="SAVE PDF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:hint="PASSWORD"
            android:textColorHint="#C9A85F"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#C9A85F"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#C9A85F"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#C9A85F">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Encrypt & Decrypt Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_encrypt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#0A361B"
                app:cardCornerRadius="14dp"
                app:strokeColor="#C9A85F"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="18sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="ENCRYPT"
                        android:textColor="#E6C97A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_decrypt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#4A1212"
                app:cardCornerRadius="14dp"
                app:strokeColor="#C9A85F"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔑"
                        android:textSize="18sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="DECRYPT"
                        android:textColor="#E6C97A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:indeterminateTint="#C9A85F"
        android:visibility="gone" />

</FrameLayout>