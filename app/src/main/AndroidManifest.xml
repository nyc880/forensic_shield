<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.lock"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LOCK"
        tools:replace="android:allowBackup">

        <activity
            android:name="com.example.lock.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.lock.TextEncryptionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.FileBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.FilePreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.EncryptionSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.ProcessingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.DecryptionSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.SafeDeleteConfirmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.SafeDeleteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.lock.MetadataConfirmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>
